NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/medilink?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# JWT Secrets - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Reset
PASSWORD_RESET_SECRET=your-password-reset-secret-change-this

# File Storage: 'local' | 'cloudinary'
FILE_STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads

# Cloudinary (required when FILE_STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Provider: 'openai' | 'none'
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4o

# Telephony Provider: 'twilio' | 'none'
TELEPHONY_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_SECRET=

# Email Provider: 'smtp' | 'none'
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@medilink.health

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Admin bootstrap (for first-run only, remove after creating admin)
# Run: npm run seed:admin
ADMIN_BOOTSTRAP_EMAIL=admin@medilink.health
ADMIN_BOOTSTRAP_PASSWORD=ChangeThisSecurePassword123!
